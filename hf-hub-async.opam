license: "MIT"
homepage: "https://github.com/TheCBaH/ocaml-hf-hub"
bug-reports: "https://github.com/TheCBaH/ocaml-hf-hub/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.17"}
  "hf-hub-unix" {= version}
  "async"
  "bigstringaf"
  "ca-certs"
  "core"
  "domain-name"
  "h2-async" {>= "0.13.0"}
  "h2-lwt-unix" {with-test}
  "tls-async"
  "uri"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
