opam-version: "2.0"
synopsis:
  "Blocking Unix driver for hf-hub: curl transport, on-disk cache, CLI"
maintainer: ["Vladimir N. Silyaev"]
authors: ["Vladimir N. Silyaev"]
license: "MIT"
homepage: "https://github.com/TheCBaH/ocaml-hf-hub"
bug-reports: "https://github.com/TheCBaH/ocaml-hf-hub/issues"
depends: [
  "ocaml" {>= "4.14"}
  "dune" {>= "3.17"}
  "cmdliner"
  "ppx_expect" {with-test}
  "hf-hub" {= version}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/TheCBaH/ocaml-hf-hub.git"
